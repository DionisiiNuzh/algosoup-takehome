{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "algosoup-takehome",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ANALYSES", "class_name": "ReviewAnalysis" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReviewAnalysis"] }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
