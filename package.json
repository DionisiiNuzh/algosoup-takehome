{
  "name": "algosoup-takehome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test src/*.test.js",
    "dev": "vite",
    "check": "tsc --noEmit && node --check src/worker.js",
    "deploy:check": "npm run build && wrangler deploy --dry-run --outdir dist-worker",
    "deploy": "npm run build && wrangler deploy",
    "dev:worker": "wrangler dev",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write index.html src/frontend vite.config.ts tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "wrangler": "^4.159.0"
  },
  "dependencies": {
    "google-play-scraper": "^10.1.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
